    <string name="restore_intro">புதிய போனா, அல்லது பயன்பாட்டை மீண்டும் நிறுவினீர்களா? எல்லாவற்றையும் திரும்பப் பெற காப்புக் கோப்பைத் திறக்கவும்.</string>
    <string name="restore_button">காப்புக் கோப்பிலிருந்து மீட்டெடு</string>
    <string name="restore_password_title">இந்தக் காப்பு பூட்டப்பட்டுள்ளது</string>
    <string name="restore_wrong_password">தவறான கடவுச்சொல். மீண்டும் முயலவும்.</string>
    <string name="restore_not_backup">இது MySelavu காப்புக் கோப்பு அல்ல.</string>
    <string name="restore_confirm_title">தற்போதைய தரவை மாற்றவா?</string>
    <string name="restore_confirm_text">%1$s அன்று எடுத்த காப்பு: %2$d செலவுகள், %3$d மாதங்கள். இது பயன்பாட்டில் இப்போது உள்ள எல்லாத் தரவையும் மாற்றிவிடும்.</string>
    <string name="restore_replace">மாற்றி மீட்டெடு</string>
    <string name="restore_done">உங்கள் தரவு மீட்டெடுக்கப்பட்டது</string>
    <string name="restore_failed">இந்தக் காப்பை மீட்டெடுக்க முடியவில்லை. தற்போதைய தரவு மாறவில்லை.</string>
    <string name="setup_restore_title">முன்பு MySelavu பயன்படுத்தினீர்களா?</string>
    <string name="setup_restore_text">காப்புக் கோப்பு இருந்தால், அமைவைத் தவிர்க்க அதை மீட்டெடுக்கவும்.</string>
    <string name="setup_restore_button">என் காப்பை மீட்டெடு</string>
    <string name="clear_title">பழைய வரலாற்றை அழி</string>
    <string name="clear_intro">பழைய செலவுகளையும் மாதச் சுருக்கங்களையும் நிரந்தரமாக நீக்கும். உங்கள் சம்பளம், பில்கள், பிரிவுகள், சேமிப்புப் பெட்டி மொத்தம், இந்த மாதம் அப்படியே இருக்கும். குறிப்பு: முதலில் காப்பு எடுக்கவும்.</string>
    <string name="clear_1y">1 ஆண்டுக்கு முந்தையவை</string>
    <string name="clear_2y">2 ஆண்டுகளுக்கு முந்தையவை</string>
    <string name="clear_5y">5 ஆண்டுகளுக்கு முந்தையவை</string>
    <string name="clear_all_past">கடந்த எல்லா மாதங்களும்</string>
    <string name="clear_confirm_years">%1$d ஆண்டுக்கு முந்தைய எல்லா வரலாற்றையும் நீக்கவா? காப்பு இல்லையென்றால் இதைத் திரும்பப் பெற முடியாது.</string>
    <string name="clear_confirm_all">கடந்த எல்லா மாதங்களின் வரலாற்றையும் நீக்கவா? இந்த மாதம் அப்படியே இருக்கும். காப்பு இல்லையென்றால் இதைத் திரும்பப் பெற முடியாது.</string>
    <string name="history_cleared">%1$d செலவுகளும் %2$d மாதங்களும் அழிக்கப்பட்டன</string>
    <string name="keep_history_title">வரலாற்றை வைத்திருக்கும் காலம்</string>
    <string name="keep_history_hint">இடத்தைச் சேமிக்க, பழைய வரலாறு தானாக அழிக்கப்படும். இயல்பாக எப்போதும் வைத்திருக்கும்.</string>
    <string name="keep_forever">எப்போதும்</string>
    <string name="keep_n_years">%1$d ஆண்டுகள்</string>
    <string name="delete_everything">எல்லாத் தரவையும் நீக்கி மீண்டும் தொடங்கு</string>
    <string name="delete_everything_confirm">இது பயன்பாட்டில் உள்ள அனைத்தையும் நீக்கி அமைவை மீண்டும் தொடங்கும். தேவைப்படலாம் என்றால் முதலில் காப்பு எடுக்கவும்.</string>
