<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 12+): back up the database and settings, not receipt photos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
